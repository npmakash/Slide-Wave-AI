    "express-rate-limit": "^7.2.0",
    "express-session": "^1.18.0",
    "googleapis": "^140.0.1",
    "helmet": "^7.1.0",
    "joi": "^17.12.2",
    "jszip": "^3.10.1",
    "mongoose": "^9.9.1",
    "multer": "^1.4.5-lts.1",
    "pdf-lib": "^1.17.1",
    "qrcode": "^1.5.3",
    "razorpay": "^2.9.8",
    "session-file-store": "^1.5.0",
    "sharp": "^0.33.3",
    "uuid": "^9.0.1",
    "winston": "^3.13.0"
