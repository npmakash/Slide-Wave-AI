{
  "name": "google-slides-bulk-generator",
  "version": "1.0.0",
  "description": "Bulk generate Google Slides presentations from Google Sheets or JSON data",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
