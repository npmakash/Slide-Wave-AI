# Google Slides Bulk Generator — Environment Variables

# ─────────────────────────────────────────────
# Google OAuth 2.0 Credentials
# Get these from: https://console.cloud.google.com/apis/credentials
# ─────────────────────────────────────────────
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# ─────────────────────────────────────────────
# Session Secret (use a long random string)
# ─────────────────────────────────────────────
SESSION_SECRET=replace_with_a_very_long_random_secret_string_here

# ─────────────────────────────────────────────
# Server Config
# ─────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ─────────────────────────────────────────────
# Frontend Origin (for CORS)
# ─────────────────────────────────────────────
FRONTEND_ORIGIN=http://localhost:3000

# ─────────────────────────────────────────────
# Rate Limiting
# ─────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# ─────────────────────────────────────────────
# Temp File Cleanup (milliseconds)
# Default: 2 hours = 7200000
# ─────────────────────────────────────────────
TEMP_FILE_TTL_MS=7200000
